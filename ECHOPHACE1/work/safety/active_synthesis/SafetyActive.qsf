# The OV7670 camera project for the DE1-SoC (Major Project). The pins carry the DE1-SoC's own names and locations,
# as in the course's pin table; top_level.sv maps the camera's signals onto GPIO_1.
set_global_assignment -name TOP_LEVEL_ENTITY top_level
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/camera_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/echo7/echo7_diag_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/clock_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/i2c_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/ov7670_config.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/ov7670_capture.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/frame_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/camera_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/video_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/rtl/top_level.sv
# The Platform Designer system with the VGA Controller. Quartus generates its Verilog from vga_sink.qsys when it
# compiles, as in Assignment 2 (make_vga_sink_qsys.tcl is the script that made the .qsys).
set_global_assignment -name QSYS_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/quartus/vga_sink.qsys
set_global_assignment -name SDC_FILE C:/Quartus_Projects/Majortut/ECHOPHACE1/quartus/Camera.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
