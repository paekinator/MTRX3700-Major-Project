# ECHO-7 Integrated V2: latest Member B plus unchanged validated Member C.
# The OV7670 camera project for the DE1-SoC (Major Project). The pins carry the DE1-SoC's own names and locations,
# as in the course's pin table; perceptionDemoTop maps camera signals onto GPIO_1.
set_global_assignment -name TOP_LEVEL_ENTITY echo7IntegratedTop
set_location_assignment PIN_AE12 -to SW[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[9]
# The Platform Designer system with the VGA Controller. Quartus generates its Verilog from vga_sink.qsys when it
# compiles. The editable vga_sink.qsys is the retained source of this IP.
set_global_assignment -name QSYS_FILE vga_sink.qsys
set_global_assignment -name SDC_FILE PartBDebug.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
