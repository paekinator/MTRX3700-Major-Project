set_location_assignment PIN_AC30 -to HEX2[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX2[6]

# All unused device pins are passive; camera GPIO remains explicitly mapped.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# AI-assisted fitter-only hold closure; Member A name/SID pending.
# Supported by installed Quartus18.1 assignment_defaults.qdf and CycloneV DSE Tcl.
# Hold/multicorner defaults made explicit; StandardFit+seed2 change placement effort.
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
# Quartus 18.1 auto effort may stop optimisation after meeting timing and fit
# requirements. The independent four-corner timing gate still decides acceptance.
set_global_assignment -name FITTER_EFFORT "AUTO FIT"
set_global_assignment -name SEED 2

# V2: distribute the internally generated SCCB clock on a low-skew global network.
# V1 fit report identifies this exact register: fanout 79, previously non-global.
# Quartus Standard 18.1 Design Recommendations section 1.4.2 and Intel AN580
# document Global Signal promotion. Verify actual routing in the final fitter
# Global & Other Fast Signals report; this is not a timing exception.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "clock_divider:sccb_clk_u|clk_out"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name SEARCH_PATH ../rtl/common
set_global_assignment -name SDC_FILE MemberBCdc.sdc
