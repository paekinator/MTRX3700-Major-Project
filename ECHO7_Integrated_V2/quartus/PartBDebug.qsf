set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_1[8]
set_location_assignment PIN_AG25 -to GPIO_1[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_1[9]

# the camera's data, HREF and VSYNC: captured in the I/O cell flops (ov7670_capture registers them straight off the pin)
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[12]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[13]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[14]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[15]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[16]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[17]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[18]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[19]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[22]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[23]
# XCLK (GPIO_1[20]) drives the camera down the ribbon: a gentle edge (4 mA, slow slew) means less overshoot
# and less crosstalk onto PCLK.
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to GPIO_1[20]
set_instance_assignment -name SLEW_RATE 0 -to GPIO_1[20]
# SIO_D and SIO_C (the camera's SCCB) need pull-ups. If the adaptor's are missing or broken, the camera is never
# configured: it sends its default YUV, a dark red, speckled picture, while the design still reports it configured
# (SIO_D stays low, so every write looks acknowledged). The FPGA's own weak pull-ups (about 25 kOhm) are enough on
# their own, and do no harm beside the adaptor's.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[24]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[25]

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
# ECHO-7 Phase 1; AI-assisted additions, reviewed by the project team before hardware use.
# Pin source: local DE1-SoC_pin_assignments.csv, SW[0..3]; cross-checked with hwtest.qsf.
set_location_assignment PIN_AB12 -to SW[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[0]
set_location_assignment PIN_AC12 -to SW[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[1]
set_location_assignment PIN_AF9 -to SW[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[2]
set_location_assignment PIN_AF10 -to SW[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[3]


# SW4 source: quartus/chassis.qsf, DE1-SoC switch assignments.
set_location_assignment PIN_AD11 -to SW[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[4]
# SW[5:7] are unused by B; SW8 selects perspective bypass. The complete SW[9:0] port must still
# retain physical locations/electrical standards. Source: local DE1-SoC
# master MTRX3700.qsf, switch rows 247--251; never allow Fitter auto-pins.
set_location_assignment PIN_AD12 -to SW[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[5]
set_location_assignment PIN_AE11 -to SW[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[6]
set_location_assignment PIN_AC9 -to SW[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[7]
set_location_assignment PIN_AD10 -to SW[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[8]

set_location_assignment PIN_AE26 -to HEX0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[0]
